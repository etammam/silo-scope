{
  "name": "silo-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Siloscope desktop application (Electron) for exploring and invoking Microsoft Orleans grains.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "postinstall": "node scripts/patch-electron-name.cjs"
  },
  "build": {
    "appId": "app.siloscope.desktop",
    "productName": "SiloScope",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/electron-updater/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "etammam",
      "repo": "silo-scope"
    }
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.30.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  }
}

{
  "name": "silo-scope",
  "version": "1.8.0",
  "private": true,
  "description": "Siloscope desktop application (Electron) for exploring and invoking Microsoft Orleans grains.",
  "desktopName": "SiloScope",
  "author": "Islam Abouzeid <eslamtammam@hotmail.com>",
  "homepage": "https://github.com/etammam/silo-scope",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "node scripts/patch-electron-name.cjs"
  },
  "build": {
    "appId": "app.siloscope.desktop",
    "productName": "SiloScope",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!resources/core/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/electron-updater/**"
    ],
    "extraResources": [
      {
        "from": "resources/core",
        "to": "core"
      }
    ],
    "electronUpdaterCompatibility": ">= 2.16",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "synopsis": "Microsoft Orleans grain explorer and invoker",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "etammam",
      "repo": "silo-scope"
    }
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  }
}
